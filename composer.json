{
    "name": "recruiterphp/array",
    "description": "Provides array_* functions you wish were part of PHP",
    "license": "MIT",
    "authors": [
        {
            "name": "Giorgio Sironi",
            "email": "work@giorgiosironi.com"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/recruiterphp/array/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.47",
        "friendsofphp/php-cs-fixer": "^3.86",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.3",
        "rector/rector": "^2.1"
    },
    "replace": {
        "onebip/onebip-array": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Recruiter\\Array\\": "src/"
        },
        "files": [
            "src/array.php",
            "src/aliases.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Recruiter\\Array\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "sort-packages": true
    }
}
